{
  "expo": {
    "name": "업무수첩",
    "slug": "worklog-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "worklog",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cetin072.worklog"
    },
    "android": {
      "package": "com.cetin072.worklog",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "업무수첩이 회의·업무 음성을 녹음하도록 마이크 사용을 허용해주세요.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
