{
  "expo": {
    "name": "업무수첩",
    "slug": "worklog-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "worklog",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cetin072.worklog"
    },
    "android": {
      "package": "com.cetin072.worklog",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "업무수첩이 회의·업무 음성을 녹음하도록 마이크 사용을 허용해주세요.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "업무수첩이 빠른 음성 업무 기록을 위해 마이크를 사용하도록 허용해주세요.",
          "speechRecognitionPermission": "업무수첩이 말한 업무를 텍스트로 변환하도록 허용해주세요.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "./plugins/with-worklog-boot-reminder-recovery.js",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
