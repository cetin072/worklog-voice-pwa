{
  "version": 2,
  "bootstrap": "npm ci",
  "preview": {
    "required": true,
    "status_context": "netlify/worklog-voice-pwa/deploy-preview",
    "wait_seconds": 600
  },
  "checks": {
    "static_regression": {
      "command": "npm test"
    },
    "environment_parity": {
      "command": "node scripts/uar-environment-parity.mjs"
    },
    "role_ui_contract": {
      "fixture_policy": "minimal",
      "command": "node scripts/uar-ui-contract.mjs"
    },
    "preview_runtime": {
      "command": "node scripts/uar-preview-runtime.mjs"
    },
    "ocr_quality": {
      "command": "node scripts/uar-ocr-quality.mjs"
    },
    "representative_smoke": {
      "command": "node scripts/uar-representative-smoke.mjs"
    },
    "visual_stability": {
      "surface_policy": "representative",
      "command": "node scripts/uar-visual-stability.mjs"
    }
  },
  "qa_escape_regressions": [
    "tests/client-stability.test.mjs",
    "tests/core-functions.test.mjs",
    "tests/briefing-v2.test.mjs",
    "scripts/uar-ocr-quality.mjs",
    "scripts/uar-visual-stability.mjs"
  ]
}
